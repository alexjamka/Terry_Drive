<?xml version="1.0" ?>
<sdf version="1.10">
    <world name="apartment">
        <physics name="1ms" type="ignored">
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1.0</real_time_factor>
        </physics>
        <plugin
            filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics">
        </plugin>
        <plugin
            filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands">
        </plugin>
        <plugin
            filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster">
        </plugin>

        <plugin
            filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
            <render_engine>ogre</render_engine>
        </plugin>


        <gui fullscreen="0">
            <plugin filename="GzScene3D" name="3D View">
                <gz-gui>
                    <title>3D View</title>
                    <property type="bool" key="showTitleBar">false</property>
                </gz-gui>
                <engine>ogre</engine>
                <scene>scene</scene>
                <ambient_light>0.4 0.4 0.4</ambient_light>
                <background_color>0.8 0.8 0.8</background_color>
                <camera_pose>0 -8 5 0 0.6 1.57</camera_pose>
            </plugin>
            <plugin filename="WorldControl" name="World control"/>
            <plugin filename="WorldStats" name="World stats"/>
            <plugin filename="VisualizeLidar" name="Visualize Lidar">
                <gz-gui>
                    <title>Visualize Lidar</title>
                </gz-gui>
                <topic>/scan</topic>
            </plugin>
        </gui>

        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <model name="ground_plane">
            <static>true</static>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                        </plane>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>
                    <material>
                        <ambient>0.8 0.8 0.8 1</ambient>
                        <diffuse>0.8 0.8 0.8 1</diffuse>
                        <specular>0.8 0.8 0.8 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Apartment walls -->
        <model name="wall_south">
            <static>true</static>
            <pose>0 -5 1 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>10 0.15 2</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>10 0.15 2</size></box></geometry>
                    <material>
                        <ambient>0.9 0.9 0.85 1</ambient>
                        <diffuse>0.9 0.9 0.85 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <model name="wall_north">
            <static>true</static>
            <pose>0 5 1 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>10 0.15 2</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>10 0.15 2</size></box></geometry>
                    <material>
                        <ambient>0.9 0.9 0.85 1</ambient>
                        <diffuse>0.9 0.9 0.85 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <model name="wall_west">
            <static>true</static>
            <pose>-5 0 1 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>0.15 10 2</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>0.15 10 2</size></box></geometry>
                    <material>
                        <ambient>0.9 0.9 0.85 1</ambient>
                        <diffuse>0.9 0.9 0.85 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <model name="wall_east">
            <static>true</static>
            <pose>5 0 1 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>0.15 10 2</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>0.15 10 2</size></box></geometry>
                    <material>
                        <ambient>0.9 0.9 0.85 1</ambient>
                        <diffuse>0.9 0.9 0.85 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Interior divider wall -->
        <model name="wall_divider">
            <static>true</static>
            <pose>0 0 1 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>0.15 6 2</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>0.15 6 2</size></box></geometry>
                    <material>
                        <ambient>0.85 0.85 0.8 1</ambient>
                        <diffuse>0.85 0.85 0.8 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Brick obstacles for lidar testing -->
        <model name="brick_1">
            <static>true</static>
            <pose>2 1 0.15 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>0.6 0.3 0.3</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>0.6 0.3 0.3</size></box></geometry>
                    <material>
                        <ambient>0.7 0.3 0.1 1</ambient>
                        <diffuse>0.7 0.3 0.1 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <model name="brick_2">
            <static>true</static>
            <pose>-1.5 -2 0.15 0 0 0.4</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>0.6 0.3 0.3</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>0.6 0.3 0.3</size></box></geometry>
                    <material>
                        <ambient>0.8 0.35 0.1 1</ambient>
                        <diffuse>0.8 0.35 0.1 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <model name="brick_3">
            <static>true</static>
            <pose>1 -1 0.25 0 0 -0.3</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>0.8 0.4 0.5</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>0.8 0.4 0.5</size></box></geometry>
                    <material>
                        <ambient>0.65 0.25 0.08 1</ambient>
                        <diffuse>0.65 0.25 0.08 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

    </world>
</sdf>
